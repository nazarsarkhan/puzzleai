# Copy this file to .env and fill in your own key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local application settings
PUZZLE_WEB_DATA=.web-data
PUZZLE_WEB_SKIP_BLENDER=0
BLENDER_EXECUTABLE=C:\Program Files (x86)\Steam\steamapps\common\Blender\blender.exe
PUZZLE_WEB_HOST=127.0.0.1
PUZZLE_WEB_PORT=8000
